{
  "name": "stayly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "better-auth": "^1.7.25",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.4.0",
    "msw": "^2.15.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
