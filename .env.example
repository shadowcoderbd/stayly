# ── Database ─────────────────────────────────────────────
POSTGRES_USER=stayly
POSTGRES_PASSWORD=stayly
POSTGRES_DB=stayly
DB_PORT=5432
# Used by `pnpm dev` / scripts on the host. Compose overrides it inside containers.
DATABASE_URL=postgres://stayly:stayly@localhost:5432/stayly

# ── App ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars
# The app's public origin. Better Auth lives at ${BETTER_AUTH_URL}/api/auth.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000
TAX_RATE=0.12
APP_TIMEZONE=UTC
UPLOAD_DIR=./data/uploads

# ── Google sign-in (optional) ────────────────────────────
# Set BOTH to enable "Continue with Google" on /login and /signup, or leave both empty to hide it.
# Setting only one of them stops the app at startup.
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# and add the redirect URI <BETTER_AUTH_URL>/api/auth/callback/google, for example:
#   http://localhost:3000/api/auth/callback/google   (pnpm dev)
#   http://localhost:3100/api/auth/callback/google   (Docker, WEB_PORT=3100)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seed demo data in the `migrate` container (idempotent).
SEED=true
